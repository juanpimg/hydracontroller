{
  "name": "hydra-controller",
  "private": true,
  "version": "1.0.0",
  "description": "Hydra Controller — Lanzador móvil y escritorio táctil dedicado para Linux vía WebRTC de ultra-baja latencia",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm server/index.ts",
    "dev:all": "concurrently \"vite\" \"tsx server/index.ts\"",
    "build:ui": "tsc && vite build",
    "build:uinput": "gcc -O2 server/uinput/hydra-uinput.c -o server/uinput/hydra-uinput",
    "build": "npm run build:uinput && npm run build:ui",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "node tests/e2e-stream.mjs",
    "test:stress": "tsx tests/stress-review.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selfsigned": "^2.4.1",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
